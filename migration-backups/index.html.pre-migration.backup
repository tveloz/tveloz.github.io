<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dr. Tomás Veloz - Academic Website</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .fade-in { animation: fadeIn 0.5s ease-in; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .section { display: none; }
        .section.active { display: block; }
        .loading { color: #6B7280; }
        .nav-btn.active { color: #2563EB; border-bottom: 2px solid #2563EB; }
        
        /* Photo Carousel Styles */
        .photo-carousel {
            position: relative;
            width: 250px;
            height: 250px;
            overflow: hidden;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }
        
        .photo-carousel-inner {
            position: relative;
            width: 100%;
            height: 100%;
        }
        
        .carousel-slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1s ease-in-out;
        }
        
        .carousel-slide.active {
            opacity: 1;
        }
        
        .carousel-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .carousel-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
            color: white;
            padding: 20px 15px 15px;
        }
        
        .carousel-description {
            font-size: 0.875rem;
            margin-bottom: 5px;
        }
        
        .carousel-location {
            font-size: 0.75rem;
            opacity: 0.9;
        }
        
        .carousel-indicators {
            position: absolute;
            top: 10px;
            right: 10px;
            display: flex;
            gap: 8px;
        }
        
        .carousel-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.5);
            cursor: pointer;
            transition: background 0.3s ease;
        }
        
        .carousel-indicator.active {
            background: white;
        }
        
        .carousel-controls {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.5);
            color: white;
            border: none;
            padding: 10px;
            cursor: pointer;
            border-radius: 50%;
            transition: background 0.3s ease;
            display: none;
        }
        
        .photo-carousel:hover .carousel-controls {
            display: block;
        }
        
        .carousel-controls:hover {
            background: rgba(0, 0, 0, 0.7);
        }
        
        .carousel-prev {
            left: 10px;
        }
        
        .carousel-next {
            right: 10px;
        }

        /* Featured Publications Carousel */
        .publications-carousel {
            position: relative;
            overflow: hidden;
            border-radius: 12px;
        }
        
        .publications-carousel-inner {
            display: flex;
            transition: transform 0.5s ease;
        }
        
        .publication-slide {
            min-width: 100%;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            margin: 0 5px;
        }
        
        .publication-slide h3 {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            line-height: 1.4;
        }
        
        .publication-slide .authors {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 8px;
        }
        
        .publication-slide .journal-info {
            font-size: 0.85rem;
            opacity: 0.8;
            margin-bottom: 12px;
        }
        
        .publication-slide .abstract {
            font-size: 0.9rem;
            line-height: 1.5;
            opacity: 0.95;
        }
        
        .publication-nav {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-top: 15px;
        }
        
        .publication-nav-btn {
            background: rgba(255, 255, 255, 0.2);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        
        .publication-nav-btn:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        .publication-indicators {
            display: flex;
            gap: 8px;
        }
        
        .publication-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.4);
            cursor: pointer;
            transition: background 0.3s ease;
        }
        
        .publication-indicator.active {
            background: white;
        }

        /* Real data indicators */
        .real-data-badge {
            background: linear-gradient(135deg, #10b981, #059669);
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 500;
        }
        
        .error-badge {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 500;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center">
                    <h1 class="text-xl font-bold text-gray-900">Dr. Tomás Veloz</h1>
                </div>
                <div class="hidden md:flex space-x-8">
                    <button onclick="showSection('about')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">About</button>
                    <button onclick="showSection('publications')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Publications</button>
                    <button onclick="showSection('projects-and-awards')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Grants & Awards</button>
                    <button onclick="showSection('events-and-dissemination')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Events & Dissemination</button>
                    <button onclick="showSection('blog')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Blog</button>
                    <button onclick="showSection('work-with-me')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">Work with Me</button>
                    <button onclick="showSection('admin-dashboard')" class="nav-btn px-3 py-2 text-sm font-medium text-gray-700 hover:text-gray-900">🔧 Admin</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Auto-update indicator with REAL DATA badge -->
        <div class="mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                    <span class="text-sm text-blue-800">Website automatically monitored via AI scraper</span>
                    <span class="real-data-badge" id="dataSource">Loading...</span>
                </div>
                <span class="text-xs text-blue-600">Last update: <span id="lastUpdate">Loading...</span></span>
            </div>
        </div>

        <!-- About Section -->
        <section id="about" class="section active fade-in">
            <div class="space-y-8">
                <!-- Top Section: Photo Carousel + Name & Affiliations -->
                <div class="bg-white rounded-lg shadow-sm p-8">
                    <div class="flex flex-col lg:flex-row items-start space-y-6 lg:space-y-0 lg:space-x-8">
                        <!-- Photo Carousel (Left) -->
