                                        <!-- Indicators will be generated dynamically -->
                                    </div>
                                    <button class="publication-nav-btn" onclick="changeFeaturedContent(1)">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Working Areas -->
                <div class="bg-white rounded-lg shadow-sm p-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-6">Working Areas</h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="p-6 rounded-lg border-l-4 border-blue-500 bg-blue-50 cursor-pointer hover:shadow-md transition-shadow" onclick="window.open('research/index.html', '_self')">
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-microscope text-blue-600 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-blue-900 mb-2">Academic Research</h3>
                                    <p class="text-blue-800 text-sm">Leading-edge research in Chemical Organization Theory, Quantum Cognition, Mathematical Modeling, and Interdisciplinary Foundations</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-6 rounded-lg border-l-4 border-green-500 bg-green-50 cursor-pointer hover:shadow-md transition-shadow" onclick="window.open('cooperation/index.html', '_self')">
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-globe-americas text-green-600 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-green-900 mb-2">International Cooperation</h3>
                                    <p class="text-green-800 text-sm">Global collaboration in academic research, sustainability initiatives, cultural exchange, and Global South development</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="p-6 rounded-lg border-l-4 border-purple-500 bg-purple-50 cursor-pointer hover:shadow-md transition-shadow" onclick="window.open('interdisciplinarity/index.html', '_self')">
                            <div class="flex items-start space-x-3">
                                <i class="fas fa-puzzle-piece text-purple-600 mt-1"></i>
                                <div>
                                    <h3 class="font-semibold text-purple-900 mb-2">Interdisciplinarity</h3>
                                    <p class="text-purple-800 text-sm">Bridging disciplines through Education, Philosophy, and Artistic approaches to knowledge integration</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Publications Section -->
        <section id="publications" class="section">
            <div class="bg-white rounded-lg shadow-sm p-8">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-900">Top 10 Most Cited Publications</h2>
                    <div class="flex items-center space-x-4">
                        <span class="text-sm text-gray-600"><span id="totalPublications" class="loading">Loading...</span> total publications</span>
                        <span class="text-sm text-gray-600"><span id="totalCitations" class="loading">Loading...</span> total citations</span>
                        <span id="publicationsDataSource" class="real-data-badge">REAL DATA</span>
                    </div>
                </div>
                
                <div id="publicationsList" class="space-y-6">
                    <!-- Publications will be loaded dynamically -->
                    <div class="text-center py-8">
                        <i class="fas fa-spinner fa-spin text-2xl text-gray-400 mb-4"></i>
                        <p class="text-gray-600">Loading publications from Google Scholar...</p>
                    </div>
                </div>
                
                <div class="mt-6 text-center">
                    <a href="https://scholar.google.com/citations?user=q7HbZQ4AAAAJ" class="text-blue-600 hover:text-blue-800 font-medium">
                        View all publications on Google Scholar →
                    </a>
                </div>
            </div>
        </section>

        <!-- Other sections remain the same... -->
        <!-- (Rest of your sections here, keeping them unchanged) -->

        <!-- Admin Dashboard Section -->
        <section id="admin-dashboard" class="section">
            <div class="bg-white rounded-lg shadow-sm p-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">🔧 Content Management Dashboard</h2>
                
                <!-- Real Data Status -->
                <div class="mb-8 p-4 bg-green-50 border border-green-200 rounded-lg">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                            <span class="text-sm text-green-800">AI Scraper Status: Active (REAL DATA)</span>
                        </div>
                        <span class="text-xs text-green-600">Last scan: <span id="lastScan">Loading...</span></span>
                    </div>
                </div>

                <!-- Content Management sections remain the same... -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">📊 Content Statistics</h3>
                        <div class="space-y-3">
                            <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                                <span>Photos</span>
                                <span class="font-medium">4</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                                <span>Videos</span>
                                <span class="font-medium">4</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                                <span>Publications (Real)</span>
                                <span class="font-medium" id="adminPublicationCount">Loading...</span>
                            </div>
                            <div class="flex justify-between items-center p-3 bg-gray-50 rounded">
                                <span>Total Citations (Real)</span>
                                <span class="font-medium" id="adminCitationCount">Loading...</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-lg font-semibold text-gray-900 mb-4">⚙️ Quick Actions</h3>
                        <div class="space-y-3">
                            <button class="w-full px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700" onclick="forceScholarUpdate()">
                                🔄 Force Scholar Update (Real)
                            </button>
                            <button class="w-full px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700">
                                🔧 Rebuild Carousels
                            </button>
                            <button class="w-full px-4 py-2 bg-purple-600 text-white rounded hover:bg-purple-700">
                                📄 View Scholar Data File
                            </button>
                            <button class="w-full px-4 py-2 bg-orange-600 text-white rounded hover:bg-orange-700">
                                🔧 Edit Content Database
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="text-gray-600 text-sm">
                    © 2025 Dr. Tomás Veloz. All rights reserved.
                </div>
                <div class="flex items-center space-x-4 mt-4 md:mt-0">
                    <span class="text-xs text-gray-500">Powered by Academic Hub AI</span>
                    <div class="flex items-center space-x-2">
                        <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                        <span class="text-xs text-gray-500">Real Data</span>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // Content data - Auto-generated by content-manager.js
        // Last updated: 2025-07-19
        let contentData = null;
        let scholarData = null;
        
        // Load content from content.json
        async function loadContentData() {
            try {
                const response = await fetch('data/content.json');
                contentData = await response.json();
                return contentData;
            } catch (error) {
                console.error('Error loading content.json:', error);
                // Fallback to hardcoded data if content.json fails
                return {
                    content: {
                        photos: [
                            {
                                filename: "2.png",
                                description: "Artificial General Intelligence Summit",
                                location: "Panama City, Panama",
                                fallback_color: "#667eea",
                                fallback_text: "Conference+Presentation"
                            },
                            {
                                filename: "1.jpg",
                                description: "Visiting UVA (Amsterdam) with Joe from UPD Philippines",
                                location: "UVA Amsterdam, The Netherlands",
                                fallback_color: "#764ba2",
                                fallback_text: "Research+Lab"
                            },
                            {
                                filename: "4.jpeg",
                                description: "Tomas Veloz, Full Stack Interdisciplinary Researcher",
                                location: "Brussels, Belgium",
                                fallback_color: "#f093fb",
                                fallback_text: "About+me"
                            },
                            {
                                filename: "3.jpg",
                                description: "Research collaboration meeting with international partners",
                                location: "Tokyo Japan",
                                fallback_color: "#4ade80",
                                fallback_text: "Collaboration"
                            }
                        ],
                        publications: [],
                        videos: []
                    }
                };
            }
        }

        // Load REAL Google Scholar data
        async function loadScholarData() {
            try {
                const response = await fetch('data/scholar-data.json');
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                scholarData = await response.json();
                console.log('📊 Loaded real Scholar data:', scholarData);
                return scholarData;
            } catch (error) {
                console.error('❌ Error loading scholar data:', error);
                // Return empty fallback data
                return {
                    totalCitations: 0,
                    totalPublications: 0,
                    mostCitedPublications: [],
                    lastUpdated: new Date().toISOString(),
                    source: 'Error - Could not load data',
                    error: error.message
                };
            }
        }

        // Force Scholar update function
        async function forceScholarUpdate() {
            const btn = event.target;
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = '🔄 Updating...';
            
            try {
                // This would call your real scraper
                const response = await fetch('/api/force-scholar-update', { 
                    method: 'POST' 
                });
                
                if (response.ok) {
                    alert('Scholar data updated successfully!');
                    // Reload the page to show new data
                    window.location.reload();
                } else {
                    alert('Error updating Scholar data');
                }
            } catch (error) {
                alert('Error updating Scholar data: ' + error.message);
                console.error(error);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        }

        // Get photo data for main carousel
        function getPhotoData() {
            if (!contentData) return [];
            
            return contentData.content.photos
                .filter(photo => photo.tags && photo.tags.includes('about-me'))
                .map(photo => ({
                    filename: photo.filename,
                    description: photo.description,
                    location: photo.location,
                    fallback: `https://via.placeholder.com/400x400/${photo.fallback_color?.replace('#', '') || '667eea'}/white?text=${photo.fallback_text || 'Photo'}`
                }));
        }

        // Get featured content (mixed: publications, videos, blog posts)
        function getFeaturedContent() {
            if (!contentData) return [];
            
            let featured = [];
            
            // Add featured publications
            if (contentData.content.publications) {
                featured = featured.concat(
                    contentData.content.publications
                        .filter(pub => pub.featured === true)
                        .map(pub => ({
                            type: 'publication',
                            title: pub.title,
                            subtitle: `${pub.journal} (${pub.year}) • ${pub.citations} citations`,
                            description: pub.abstract,
                            authors: pub.authors,
                            url: pub.url,
                            icon: '📖'
                        }))
                );
            }
            
            // Add featured videos
            if (contentData.content.videos) {
                featured = featured.concat(
                    contentData.content.videos
                        .filter(video => video.tags && video.tags.includes('featured'))
                        .map(video => ({
                            type: 'video',
                            title: video.title,
                            subtitle: `YouTube Video • ${video.duration}`,
                            description: video.description,
                            url: `https://www.youtube.com/watch?v=${video.youtube_id}`,
                            thumbnail: video.thumbnail,
                            icon: '🎥'
                        }))
                );
            }
            
            // Add featured blog posts
            if (contentData.content.blog_posts) {
                featured = featured.concat(
                    contentData.content.blog_posts
                        .filter(blog => blog.featured === true)
                        .map(blog => ({
                            type: 'blog',
                            title: blog.title,
                            subtitle: `${blog.platform} • ${blog.date}`,
                            description: blog.description,
                            url: blog.url,
                            icon: '✍️'
                        }))
                );
            }
            
            return featured;
        }

        // Carousel settings
        const carouselSettings = {
            rotation_speed: 8000,
            transition_effect: "fade",
            auto_start: true,
            random_start: true,
            pause_on_hover: true
        };
        
        // Photo Carousel functionality (unchanged)
        let currentSlide = 0;
        let carouselInterval = null;
        let isCarouselPaused = false;
        let photoData = [];

        async function initializeCarousel() {
            await loadContentData();
            photoData = getPhotoData();
            
            const slidesContainer = document.getElementById('carouselSlides');
            const indicatorsContainer = document.getElementById('carouselIndicators');
            
            if (photoData.length === 0) {
                slidesContainer.innerHTML = '<div class="flex items-center justify-center h-full bg-gray-100 text-gray-500">No photos available</div>';
                return;
            }
            
            // Create slides
            photoData.forEach((photo, index) => {
                // Create slide
                const slide = document.createElement('div');
                slide.className = `carousel-slide ${index === 0 ? 'active' : ''}`;
                
                const img = document.createElement('img');
                img.onerror = function() {
                    this.src = photo.fallback;
                };
                img.src = `pics/${photo.filename}`;
                img.alt = photo.description;
                
                const overlay = document.createElement('div');
                overlay.className = 'carousel-overlay';
                overlay.innerHTML = `
                    <div class="carousel-description">${photo.description}</div>
                    <div class="carousel-location">${photo.location}</div>
                `;
                
                slide.appendChild(img);
                slide.appendChild(overlay);
                slidesContainer.appendChild(slide);
                
                // Create indicator
                const indicator = document.createElement('div');
                indicator.className = `carousel-indicator ${index === 0 ? 'active' : ''}`;
                indicator.onclick = () => goToSlide(index);
                indicatorsContainer.appendChild(indicator);
            });
            
            // Start auto-rotation if enabled
            if (carouselSettings.auto_start) {
                // Start from random slide if enabled
                if (carouselSettings.random_start) {
                    currentSlide = Math.floor(Math.random() * photoData.length);
                    goToSlide(currentSlide);
                }
                startCarousel();
            }
            
            // Add pause on hover
            if (carouselSettings.pause_on_hover) {
                const carousel = document.querySelector('.photo-carousel');
                carousel.addEventListener('mouseenter', pauseCarousel);
                carousel.addEventListener('mouseleave', resumeCarousel);
            }
        }

        function goToSlide(slideIndex) {
            const slides = document.querySelectorAll('.carousel-slide');
            const indicators = document.querySelectorAll('.carousel-indicator');
            
            if (slides.length === 0) return;
            
            // Remove active class from current slide and indicator
            slides[currentSlide]?.classList.remove('active');
            indicators[currentSlide]?.classList.remove('active');
            
            // Set new current slide
            currentSlide = slideIndex;
            
            // Add active class to new slide and indicator
            slides[currentSlide]?.classList.add('active');
            indicators[currentSlide]?.classList.add('active');
        }

        function changeSlide(direction) {
            if (photoData.length === 0) return;
            const newSlide = (currentSlide + direction + photoData.length) % photoData.length;
            goToSlide(newSlide);
        }

        function nextSlide() {
            changeSlide(1);
        }

        function startCarousel() {
            if (carouselInterval) clearInterval(carouselInterval);
            carouselInterval = setInterval(nextSlide, carouselSettings.rotation_speed);
        }

        function pauseCarousel() {
            if (carouselInterval) {
                clearInterval(carouselInterval);
                isCarouselPaused = true;
            }
        }

        function resumeCarousel() {
            if (isCarouselPaused && carouselSettings.auto_start) {
                startCarousel();
                isCarouselPaused = false;
            }
        }

        // Featured Content Carousel (unchanged)
        let currentFeaturedContent = 0;
        let featuredContentInterval = null;
        let featuredContent = [];

        async function initializeFeaturedContent() {
            if (!contentData) await loadContentData();
            featuredContent = getFeaturedContent();
            
            const container = document.getElementById('featuredCarouselInner');
            const indicators = document.getElementById('featuredIndicators');
            
            if (featuredContent.length === 0) {
                container.innerHTML = '<div class="publication-slide">No featured content available</div>';
                return;
            }
            
            // Create content slides (same as before)
            featuredContent.forEach((content, index) => {
                const slide = document.createElement('div');
                slide.className = 'publication-slide';
                
                let slideContent = '';
                
                if (content.type === 'publication') {
                    slideContent = `
                        <div style="display: flex; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 1.5rem; margin-right: 10px;">${content.icon}</span>
                            <h3>${content.title}</h3>
                        </div>
                        <div class="authors">${content.authors}</div>
                        <div class="journal-info">${content.subtitle}</div>
                        <div class="abstract">${content.description}</div>
                    `;
                } else if (content.type === 'video') {
                    slideContent = `
                        <div style="display: flex; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 1.5rem; margin-right: 10px;">${content.icon}</span>
                            <h3>${content.title}</h3>
                        </div>
                        <div class="journal-info">${content.subtitle}</div>
                        <div class="abstract">${content.description}</div>
                    `;
                } else if (content.type === 'blog') {
                    slideContent = `
                        <div style="display: flex; align-items: center; margin-bottom: 10px;">
                            <span style="font-size: 1.5rem; margin-right: 10px;">${content.icon}</span>
                            <h3>${content.title}</h3>
                        </div>
                        <div class="journal-info">${content.subtitle}</div>
                        <div class="abstract">${content.description}</div>
                    `;
                }
                
                slide.innerHTML = slideContent;
                slide.style.cursor = 'pointer';
                slide.onclick = () => window.open(content.url, '_blank');
                
                container.appendChild(slide);
                
                // Create indicator
                const indicator = document.createElement('div');
                indicator.className = `publication-indicator ${index === 0 ? 'active' : ''}`;
                indicator.onclick = () => goToFeaturedContent(index);
                indicators.appendChild(indicator);
            });

            // Auto-advance every 15 seconds
            startFeaturedContent();
        }

        function goToFeaturedContent(index) {
            const container = document.getElementById('featuredCarouselInner');
            const indicators = document.querySelectorAll('.publication-indicator');
            
            if (!container || indicators.length === 0) return;
            
            // Update indicators
            indicators[currentFeaturedContent]?.classList.remove('active');
            indicators[index]?.classList.add('active');
            
            // Update current index
            currentFeaturedContent = index;
            
            // Move carousel
            container.style.transform = `translateX(-${index * 100}%)`;
        }

        function changeFeaturedContent(direction) {
            if (featuredContent.length === 0) return;
            const newIndex = (currentFeaturedContent + direction + featuredContent.length) % featuredContent.length;
            goToFeaturedContent(newIndex);
        }

        function startFeaturedContent() {
            if (featuredContentInterval) clearInterval(featuredContentInterval);
            featuredContentInterval = setInterval(() => {
                changeFeaturedContent(1);
            }, 15000);
        }

        // Navigation functionality
        function showSection(sectionId) {
            // Hide all sections
            document.querySelectorAll('.section').forEach(section => {
                section.classList.remove('active');
            });
            
            // Show selected section
            document.getElementById(sectionId).classList.add('active');
            
            // Update navigation
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            event.target.classList.add('active');
        }

        // REAL Google Scholar data loading - replaces fake data
        async function updateScholarStats() {
            try {
                const data = await loadScholarData();
                
                if (data && !data.error) {
                    // Update counts in multiple locations
                    document.getElementById('citationCount').textContent = `${data.totalCitations} citations`;
                    document.getElementById('citationCountText').textContent = `${data.totalCitations}`;
                    document.getElementById('publicationCount').textContent = `${data.totalPublications}`;
                    document.getElementById('totalPublications').textContent = `${data.totalPublications}`;
                    document.getElementById('totalCitations').textContent = `${data.totalCitations}`;
                    document.getElementById('adminPublicationCount').textContent = `${data.totalPublications}`;
                    document.getElementById('adminCitationCount').textContent = `${data.totalCitations}`;
                    
                    // Update data source badges
                    const dataSourceElement = document.getElementById('dataSource');
                    const publicationsDataSource = document.getElementById('publicationsDataSource');
                    
                    if (data.source && data.source.includes('Live Scraping')) {
                        dataSourceElement.textContent = 'REAL DATA - Live';
                        dataSourceElement.className = 'real-data-badge';
                        publicationsDataSource.textContent = 'REAL DATA - Live';
                        publicationsDataSource.className = 'real-data-badge';
                    } else if (data.source && data.source.includes('Fallback')) {
                        dataSourceElement.textContent = 'CACHED DATA';
                        dataSourceElement.className = 'real-data-badge';
                        publicationsDataSource.textContent = 'CACHED DATA';
                        publicationsDataSource.className = 'real-data-badge';
                    } else if (data.error) {
                        dataSourceElement.textContent = 'ERROR';
                        dataSourceElement.className = 'error-badge';
                        publicationsDataSource.textContent = 'ERROR';
                        publicationsDataSource.className = 'error-badge';
                    }
                    
                    // Update publications list with REAL data
                    const publicationsList = document.getElementById('publicationsList');
                    publicationsList.innerHTML = '';
                    
                    if (data.mostCitedPublications && data.mostCitedPublications.length > 0) {
                        data.mostCitedPublications.forEach(pub => {
                            const pubDiv = document.createElement('div');
                            pubDiv.className = 'border-l-4 border-green-500 pl-6 py-4 hover:bg-gray-50 transition-colors';
                            pubDiv.innerHTML = `
                                <div class="flex items-start justify-between">
                                    <div class="flex-1">
                                        <div class="flex items-center space-x-2 mb-2">
                                            <span class="w-8 h-8 bg-green-100 text-green-700 rounded-full flex items-center justify-center text-sm font-bold">#${pub.rank}</span>
                                            <h3 class="text-lg font-semibold text-gray-900">${pub.title}</h3>
                                        </div>
                                        <p class="text-gray-600 mb-2">${pub.authors}</p>
                                        <p class="text-green-600 font-medium mb-2">${pub.journal || 'Journal'} (${pub.year})</p>
                                        <div class="flex items-center space-x-4 text-sm text-gray-500">
                                            <span class="font-semibold text-green-700">${pub.citations} citations</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <button class="p-2 text-blue-600 hover:bg-blue-50 rounded">
                                            <i class="fas fa-external-link-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            `;
                            publicationsList.appendChild(pubDiv);
                        });
                    } else {
                        publicationsList.innerHTML = '<div class="text-center py-8 text-gray-500">No publications data available</div>';
                    }
                    
                    console.log('✅ Updated UI with real Scholar data');
                } else {
                    console.error('❌ Error in Scholar data:', data?.error || 'Unknown error');
                    
                    // Show error state
                    document.getElementById('dataSource').textContent = 'ERROR';
                    document.getElementById('dataSource').className = 'error-badge';
                    document.getElementById('publicationsDataSource').textContent = 'ERROR';
                    document.getElementById('publicationsDataSource').className = 'error-badge';
                    
                    document.getElementById('publicationsList').innerHTML = `
                        <div class="text-center py-8 text-red-500">
                            <i class="fas fa-exclamation-triangle text-2xl mb-4"></i>
                            <p>Error loading Scholar data: ${data?.error || 'Unknown error'}</p>
                        </div>
                    `;
                }
            } catch (error) {
                console.error('❌ Error updating Scholar stats:', error);
                
                // Show error state
                document.getElementById('dataSource').textContent = 'ERROR';
                document.getElementById('dataSource').className = 'error-badge';
                document.getElementById('publicationsDataSource').textContent = 'ERROR';
                document.getElementById('publicationsDataSource').className = 'error-badge';
            }
        }

        // Update last update time
        function updateLastUpdateTime() {
            if (scholarData && scholarData.lastUpdated) {
                const lastUpdate = new Date(scholarData.lastUpdated);
                document.getElementById('lastUpdate').textContent = lastUpdate.toLocaleString();
                document.getElementById('lastScan').textContent = lastUpdate.toLocaleString();
            } else {
                const now = new Date();
                document.getElementById('lastUpdate').textContent = now.toLocaleString();
            }
        }
        
        // Initialize everything
        document.addEventListener('DOMContentLoaded', async function() {
            await initializeCarousel();
            await initializeFeaturedContent();
            await updateScholarStats();
            updateLastUpdateTime();
            
            // Show about section by default
            document.querySelector('.nav-btn').classList.add('active');
            
            // Auto-update every 5 minutes
            setInterval(updateLastUpdateTime, 300000);
            setInterval(updateScholarStats, 300000);
        });
    </script>
</body>
</html>